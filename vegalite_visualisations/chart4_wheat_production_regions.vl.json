{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
    "text": "Australia's Top Wheat Producing Regions",
    "subtitle": "Top 10 Australian regions by wheat production 2020–21",
    "anchor": "start"
    },
    "width": 600,
    "height": 350,
    "data": {
    "url": "https://raw.githubusercontent.com/majonk1/FIT3179-DV2-Matthew-Jenkin/refs/heads/main/data/wheat_production_by_region.csv",
    "format": {
        "type": "csv",
        "parse": {
        "Production": "number"
        }
    }
    },
    "transform": [
    {
        "window": [
        {
            "op": "rank",
            "as": "Rank"
        }
        ],
        "sort": [
        {
            "field": "Production",
            "order": "descending"
        }
        ]
    },
    {
        "filter": "datum.Rank <= 10"
    }
    ],
    "encoding": {
    "y": {
        "field": "Region",
        "type": "nominal",
        "sort": {
        "field": "Production",
        "order": "descending"
        },
        "title": null
    },
    "x": {
        "field": "Production",
        "type": "quantitative",
        "title": "Wheat Production(tonnes)",
        "axis": {
        "format": "~s"
        }
    },
    "tooltip": [
        {
        "field": "Rank",
        "type": "quantitative",
        "title": "Rank",
        "format": ".0f"
        },
        {
        "field": "Region",
        "type": "nominal",
        "title": "Region"
        },
        {
        "field": "Production",
        "type": "quantitative",
        "title": "Wheat Production(tonnes)",
        "format": ",.0f"
        }
    ]
    },
    "layer": [
    {
        "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#789A49"
        },
        "encoding": {
        "x2": {
            "datum": 0
        },
        "opacity": {
            "condition": {
                "param": "region_hover",
                "value": 1
            },
            "value": 0.4
        }
        }
    },
    {
        "params": [
        {
            "name": "region_hover",
            "select": {
            "type": "point",
            "fields": ["Region"],
            "on": "pointerover",
            "clear": "pointerout"
            }
        }
        ],
        "mark": {
        "type": "point",
        "filled": true,
        "size": 140,
        "color": "#789A49"
        },
        "encoding": {
        "opacity": {
            "condition": {
            "param": "region_hover",
            "value": 1,
            "empty": true
            },
            "value": 0.4
        }
        }
    }
    ]
}